generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoomKind {
  STANDARD
  COMPOSITE
  SECTION
  MINIBUS
  PARKING
  PARKING_BAY
}

enum BookingSource {
  PORTAL
  IPAD_QR
}

enum DeviceScope {
  STANDARD
  SECTION
  COMPOSITE
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Room {
  id           String   @id @default(cuid())
  mailboxUpn   String?  @unique
  displayName  String
  building     String?
  floor        String?
  capacity     Int
  equipment    String[]
  bookable     Boolean  @default(true)
  timezone     String   @default("Europe/London")

  kind         RoomKind @default(STANDARD)
  parentRoomId String?
  parent       Room?    @relation("RoomSections", fields: [parentRoomId], references: [id])
  sections     Room[]   @relation("RoomSections")

  allowedGroups String[]

  bookings Booking[]
  devices  Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id                 String        @id @default(cuid())
  graphEventId       String        @unique
  graphICalUid       String        @unique
  roomId             String
  room               Room          @relation(fields: [roomId], references: [id])
  organiserUpn       String
  organiserName      String
  subject            String
  startUtc           DateTime
  endUtc             DateTime
  isAllDay           Boolean       @default(false)
  source             BookingSource
  lastSyncedAt       DateTime      @default(now())
  recurringGroupId   String?

  // Phase 3: premises notifications
  premisesNotes      String?
  premisesNotifyHash String?       // SHA-256 of notify-relevant fields; skip notification if unchanged
  primaryMailboxUpn  String?       // mailbox where the Graph event lives; used for updates/deletes

  @@index([roomId, startUtc, endUtc])
  @@index([organiserUpn])
  @@index([recurringGroupId])
}

model Device {
  id          String      @id @default(cuid())
  roomId      String
  room        Room        @relation(fields: [roomId], references: [id])
  scope       DeviceScope
  pairingCode String?
  tokenHash   String
  lastSeenAt  DateTime?
  enrolledAt  DateTime    @default(now())
  name        String?

  @@index([roomId])
}

model User {
  upn                    String    @id
  displayName            String
  isStaff                Boolean
  isAdmin                Boolean   @default(false)
  groupIds               String[]
  lastLoginAt            DateTime?
  termsAcceptedAt        DateTime?
}

model GraphSubscription {
  id          String   @id
  resource    String
  roomId      String
  expiresAt   DateTime
  clientState String
  createdAt   DateTime @default(now())

  @@index([roomId])
  @@index([expiresAt])
}

model AuditLog {
  id       String   @id @default(cuid())
  actor    String
  action   String
  targetId String?
  metadata Json
  at       DateTime @default(now())

  @@index([at])
  @@index([actor, at])
}

// Admin-uploaded assets stored in Postgres (original data we own, not a Graph
// cache). Keyed by a stable slug, e.g. "minibus-checklist". Small files only —
// attached inline to confirmation emails.
model ManagedFile {
  key         String   @id
  filename    String
  contentType String
  data        Bytes
  size        Int
  uploadedBy  String
  uploadedAt  DateTime @default(now())
}
