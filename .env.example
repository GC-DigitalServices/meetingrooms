# ============================================================
# Room Booking Platform — environment variable reference
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# ============================================================

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (injected by Railway in production) ─────────────
# Local: matches docker-compose.yml defaults.
DATABASE_URL=postgresql://mrbs:mrbs@localhost:5432/mrbs

# ── Redis (injected by Railway in production) ────────────────
# Local: matches docker-compose.yml defaults.
REDIS_URL=redis://localhost:6379

# ── Microsoft Entra ID / MSAL ────────────────────────────────
# From the "College Room Booking" app registration in Entra ID.
# Tenant ID: Azure portal → Entra ID → Overview → Tenant ID
AZURE_TENANT_ID=your-tenant-id-here

# Client (Application) ID: App registrations → your app → Overview
AZURE_CLIENT_ID=your-client-id-here

# Client secret: App registrations → your app → Certificates & secrets
# Rotate every 12 months. See docs/runbooks/secret-rotation.md.
AZURE_CLIENT_SECRET=your-client-secret-here

# ── Session ───────────────────────────────────────────────────
# Random string, minimum 32 characters. Used to sign session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# ── QR code signing ───────────────────────────────────────────
# Random string, minimum 32 characters. Used to sign short-lived QR tokens.
# Generate with: openssl rand -base64 32
# Rotate every 12 months. Old key remains valid for 24h after rotation.
QR_SIGNING_KEY=replace-with-at-least-32-random-characters

# ── Public URL ────────────────────────────────────────────────
# The full public URL of the deployed app. Used for OAuth redirect URIs,
# QR code deep links, and Graph webhook subscription callbacks.
# Local dev: use ngrok or similar if you need Graph webhooks.
PUBLIC_BASE_URL=http://localhost:3000
